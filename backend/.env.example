# ── Option 1: OpenAI ─────────────────────────────────────────────
# LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Option 2: Anthropic ──────────────────────────────────────────
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── Option 3: LM Studio (local, OpenAI-compatible, no key) ──────
# LLM_PROVIDER=lmstudio
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=liquid/lfm2.5-1.2b

# ── Option 4: OpenRouter (100+ models behind one key) ───────────
# LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# model = "vendor/name", e.g.:
#   meta-llama/llama-3.3-70b-instruct
#   anthropic/claude-3.5-haiku
#   google/gemini-2.0-flash-001
#   qwen/qwen-2.5-72b-instruct
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Option 5: Groq (fastest inference, Llama/Qwen/Mixtral) ──────
# LLM_PROVIDER=groq
GROQ_API_KEY=
# e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant, qwen-2.5-32b
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Option 6: DeepInfra ─────────────────────────────────────────
# LLM_PROVIDER=deepinfra
DEEPINFRA_API_KEY=
# e.g. meta-llama/Llama-3.3-70B-Instruct, Qwen/Qwen2.5-72B-Instruct
DEEPINFRA_MODEL=meta-llama/Llama-3.3-70B-Instruct
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

# ── Option 7: NVIDIA NIM (build.nvidia.com, free credits) ───────
# LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
# e.g. meta/llama-3.3-70b-instruct, nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ─ Langfuse (Q2+ observability — Cloud) ────────────────────────
# Leave blank to run untraced: the app still works end-to-end and the UI shows
# "Observability: off". Paste keys from cloud.langfuse.com → project → Settings
# → API Keys to enable real tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Q2 paper engine ─────────────────────────────────────────────
# Where uploaded-paper JSON records live (default: backend/data/papers).
# Q2_DATA_DIR=

# ── Q3 RAG embeddings (local, no key needed) ───────────────────
# Runs locally via sentence-transformers — no network, no per-call cost.
# Only LLM *generation* uses the provider chosen above.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

